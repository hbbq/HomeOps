{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Acquisition": {
    "IntervalSeconds": 30,
    "MaxConcurrentSourceReads": 4
  },
  "Simulator": {
    "Enabled": true
  },
  "SmartThings": {
    "Enabled": false,
    "BaseUrl": "https://api.smartthings.com/v1/",
    "DeviceIds": [],
    "TimeoutSeconds": 15,
    "MaxConcurrentDeviceReads": 4
  }
}
