{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Acquisition": {
    "IntervalSeconds": 30,
    "MaxConcurrentSourceReads": 4
  },
  "Simulator": {
    "Enabled": true
  },
  "SmartThings": {
    "Enabled": true,
    "AuthenticationMode": "OAuth",
    "BaseUrl": "https://api.smartthings.com/v1/",
    "TimeoutSeconds": 15,
    "MaxConcurrentDeviceReads": 4,
    "MotionHoldSeconds": 120,
    "TemperatureDeadbandCelsius": 0.3
  },
  "SmhiWeather": {
    "Enabled": true,
    "BaseUrl": "https://opendata-download-metobs.smhi.se/api/version/1.0/",
    "StationId": "72420",
    "StationName": "",
    "PollingIntervalMinutes": 15,
    "TimeoutSeconds": 15
  }
}
